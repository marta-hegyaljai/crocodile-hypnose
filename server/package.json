{
  "name": "mhp-dev-server",
  "version": "0.1.0",
  "private": true,
  "description": "Dev stand-in for the shared MHP account service and the MHP Hypnose app API.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "create-user": "node --disable-warning=ExperimentalWarning scripts/create-user.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  }
}
